# Line endings are pinned so the repository never churns because of them.
# This project hit that problem once already: a tool rewrote every file with
# CRCRLF and the source grew to twice its size.

* text=auto eol=crlf

# Source and scripts: Windows line endings, matching the existing files
*.cs        text eol=crlf
*.xaml      text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.txt       text eol=crlf

# Data and documentation read better with LF
*.json      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.csv       text eol=lf

# Never touch these
*.db        binary
*.db-wal    binary
*.db-shm    binary
*.zip       binary
*.png       binary
*.jpg       binary
*.ico       binary
*.dll       binary
*.exe       binary
*.pdb       binary

# Keep generated files out of diffs
*.designer.cs linguist-generated=true
