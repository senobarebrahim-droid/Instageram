<Window x:Class="Instageram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Instageram"
        Title="INSTAGERAM - Portable Ú©Ù…Ù¾ÛŒÙ† Manager"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}" Loaded="MainWindow_Loaded">
    <Window.Resources>
        <Style x:Key="CountryComboBoxItemTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="MaxWidth" Value="340"/>
        </Style>

        <DataTemplate x:Key="CountryItemTemplate">
            <TextBlock Text="{Binding Ù†Ø§Ù…, FallbackValue={Binding}}"
                       Style="{StaticResource CountryComboBoxItemTextStyle}"
                       ToolTip="{Binding Ù†Ø§Ù…, FallbackValue={Binding}}"/>
        </DataTemplate>

        <DataTemplate x:Key="CountrySelectedTemplate">
            <TextBlock Text="{Binding Ù†Ø§Ù…, FallbackValue={Binding}}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Ù†Ø§Ù…, FallbackValue={Binding}}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="INSTAGERAM" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                    <TextBlock Text="{loc:Text header_subtitle}"
                               Foreground="{DynamicResource HeaderForeground}" Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="PathText" Foreground="{DynamicResource HeaderSubtle}"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs">

            <TabItem Header="{loc:Text tab_dashboard}">
                <StackPanel Margin="22">
                    <TextBlock Text="{loc:Text dashboard_title}"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,16"/>

                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Margin="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Text card_projects}" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="ProjectsText" Text="Ù¾Ø±ÙˆÚ˜Ù‡â€ŒÙ‡Ø§" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Margin="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Text card_campaigns}" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="CampaignsText" Text="Ú©Ù…Ù¾ÛŒÙ†â€ŒÙ‡Ø§" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Margin="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Text card_target}" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TargetText" Text="ØªØ¹Ø¯Ø§Ø¯ Ù‡Ø¯Ù" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Margin="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Text card_progress}" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="ProgressText" Text="Ù¾ÛŒØ´Ø±ÙØª" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextSuccess}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid x:Name="CampaignGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="300"/>
                </StackPanel>
            </TabItem>

                        <TabItem Header="{loc:Text tab_campaign}">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="9" Padding="24" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Text campaign_title}"
                                       FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,18"/>

                            <TextBlock Text="{loc:Text label_instagram_url}"/>
                            <TextBox x:Name="UrlBox" Height="34" Margin="0,6,0,15" Padding="8"
                                     ToolTip="https://www.instagram.com/example/"/>

                            <TextBlock Text="{loc:Text label_country_name}"/>
                            <TextBox x:Name="NameBox" Height="34" Margin="0,6,0,15" Padding="8"/>

                            <TextBlock Text="{loc:Text label_target_number}"/>
                            <TextBox x:Name="TargetBox" Text="1000" Height="34" Margin="0,6,0,15" Padding="8"/>

                            <TextBlock Text="{loc:Text label_current_result}"/>
                            <TextBox x:Name="CurrentBox" Text="0" Height="34" Margin="0,6,0,15" Padding="8"/>

                            <TextBlock Text="{loc:Text label_countries}"/>
                            <ListBox x:Name="CountryList" Height="145" SelectionMode="Multiple" Margin="0,6,0,18"/>

                            <WrapPanel>

<Button Content="{loc:Text btn_analyze}"
        Click="Analyze_Click"
        Background="{DynamicResource AccentPrimary}"
        Foreground="{DynamicResource OnAccent}"
        Padding="16,9"
        Margin="0,0,10,0"/>

<Button Content="{loc:Text btn_create_campaign}"
        Click="Create_Click"
        Background="{DynamicResource AccentSuccess}"
        Foreground="{DynamicResource OnAccent}"
        Padding="16,9"/>

<Button Content="{loc:Text btn_save_campaign}"
        Click="SaveCampaign_Click"
        Background="{DynamicResource AccentDark}"
        Foreground="{DynamicResource OnAccent}"
        Padding="16,9"
        Margin="10,0,0,0"/>

<Button Content="{loc:Text btn_run}"
        Click="Run_Click"
        Background="{DynamicResource AccentWarning}"
        Foreground="{DynamicResource OnAccent}"
        Padding="16,9"
        Margin="10,0,0,0"/>

</WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="22"
                            Margin="0,0,0,0">

                        <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{loc:Text manual_title}"
               FontSize="24"
               FontWeight="Bold"
               Foreground="{DynamicResource TextPrimary}"
               Margin="0,0,0,12"/>

    <TextBlock Grid.Row="1"
               Text="{loc:Text manual_description}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextBody}"
               Margin="0,0,0,16"/>

    <WrapPanel Grid.Row="2"
               Margin="0,0,0,18">
        <Button Content="{loc:Text btn_start_manual}"
                Click="StartManualWorkflow_Click"
                Background="{DynamicResource AccentSuccess}"
                Foreground="{DynamicResource OnAccent}"
                BorderThickness="0"
                Padding="16,10"
                Margin="0,0,8,8"/>

        <Button Content="{loc:Text btn_open_profile}"
                Click="OpenCurrentProfile_Click"
                Background="{DynamicResource AccentPrimary}"
                Foreground="{DynamicResource OnAccent}"
                BorderThickness="0"
                Padding="16,10"
                Margin="0,0,8,8"/>

        <Button Content="{loc:Text btn_complete}"
                Click="CompleteCurrent_Click"
                Background="{DynamicResource AccentSuccess}"
                Foreground="{DynamicResource OnAccent}"
                BorderThickness="0"
                Padding="16,10"
                Margin="0,0,8,8"/>

        <Button Content="{loc:Text btn_reject}"
                Click="RejectCurrent_Click"
                Background="{DynamicResource AccentNeutral}"
                Foreground="{DynamicResource OnAccent}"
                BorderThickness="0"
                Padding="16,10"
                Margin="0,0,8,8"/>

        <Button Content="{loc:Text btn_next}"
                Click="NextCurrent_Click"
                Background="{DynamicResource AccentDark}"
                Foreground="{DynamicResource OnAccent}"
                BorderThickness="0"
                Padding="16,10"
                Margin="0,0,8,8"/>

        <Button x:Name="ImportUsersButton"
                Content="{loc:Text btn_import_users}"
                Click="ImportUsers_Click"
                Background="{DynamicResource AccentPrimary}"
                Foreground="{DynamicResource OnAccent}"
                BorderThickness="0"
                Padding="16,10"
                Margin="0,0,8,8"/>
    </WrapPanel>

    <Border Grid.Row="3"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="20"
            Margin="0,0,0,0">

        <StackPanel>
            <TextBlock Text="{loc:Text manual_current_caption}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="ManualCurrentText"
                       Text="{loc:Text manual_current_placeholder}"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="ManualQueueText"
                       Text="{loc:Text manual_queue_initial}"
                       Foreground="{DynamicResource TextBody}"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="ManualStatusText"
                       Text="{loc:Text manual_status_ready}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSuccess}"/>
        </StackPanel>
    </Border>
</Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Text tab_validation}">
                <StackPanel Margin="28">
                    <TextBlock Text="{loc:Text validation_title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <Border Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="24"
                            Margin="0,20,0,0">

                        <StackPanel>
                            <TextBlock x:Name="ResultText"
                                       Margin="0,0,0,15"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBody}"
                                       Text="Ù†ØªÛŒØ¬Ù‡"/>

                            <Separator Margin="0,10,0,20"/>

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBody}"
                                       Text="{loc:Text validation_disclaimer}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
<TabItem Header="{loc:Text tab_reports}">
                <StackPanel Margin="28">
                    <TextBlock Text="{loc:Text reports_title}"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Margin="0,12,0,16" TextWrapping="Wrap"
                               Text="{loc:Text reports_description}"/>

                    <WrapPanel>
                        <Button Content="{loc:Text btn_export}" Click="Export_Click"
                                Background="{DynamicResource AccentPrimary}" Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                Padding="18,10" Margin="0,0,12,0"/>
                        <Button Content="{loc:Text btn_export_xlsx}" Click="ExportXlsx_Click"
                                Background="{DynamicResource AccentSuccess}" Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                Padding="18,10" Margin="0,0,12,0"/>
                        <Button Content="{loc:Text btn_export_html}" Click="ExportHtml_Click"
                                Background="{DynamicResource AccentSuccess}" Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                Padding="18,10" Margin="0,0,12,0"/>
                        <Button Content="{loc:Text btn_backup}" Click="Backup_Click"
                                Background="{DynamicResource AccentNeutral}" Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                Padding="18,10"/>

                        <Button Content="{loc:Text btn_restore}"
                                Click="Restore_Click"
                                Background="{DynamicResource AccentDark}" Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                Padding="18,10" Margin="12,0,0,0"/>
                    </WrapPanel>

                    <TextBlock x:Name="ActionText" Margin="0,20,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSuccess}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="{loc:Text tab_settings}">
                <StackPanel Margin="28">
                    <TextBlock Text="{loc:Text settings_title}"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>

                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                            CornerRadius="9" Padding="24" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Text settings_theme}" Foreground="{DynamicResource TextMuted}"/>
                            <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left"
                                      Margin="0,6,0,16" SelectionChanged="ThemeBox_SelectionChanged"/>

                            <TextBlock Text="{loc:Text settings_language}" Foreground="{DynamicResource TextMuted}"/>
                            <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left"
                                      Margin="0,6,0,16" SelectionChanged="LanguageBox_SelectionChanged"/>

                            <CheckBox x:Name="AutoBackupBox"
                                      Content="{loc:Text settings_auto_backup}"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="IntegrityCheckBox"
                                      Content="{loc:Text settings_integrity}"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="{loc:Text btn_save_settings}" Click="SaveSettings_Click"
                                Background="{DynamicResource AccentSuccess}" Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                Padding="18,10" Margin="0,0,12,0"/>
                        <Button Content="{loc:Text btn_reload_settings}" Click="ReloadSettings_Click"
                                Background="{DynamicResource AccentPrimary}" Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                Padding="18,10"/>
                    </WrapPanel>

                    <TextBlock x:Name="SettingsInfoText" Margin="0,16,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSuccess}"/>

                    <TextBlock x:Name="SettingsPathsText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"/>

                    <TextBlock x:Name="SettingsVersionText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="{loc:Text tab_statistics}">
                <ScrollViewer x:Name="StatisticsScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Text="{loc:Text stats_title}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="22" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Text stats_campaign}"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <ComboBox x:Name="StatsCampaignBox" Width="380"
                                          HorizontalAlignment="Left" Margin="0,6,0,16"
                                          SelectionChanged="StatsCampaignBox_SelectionChanged"/>

                                <WrapPanel>
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Text="{loc:Text stats_date}"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBox x:Name="StatsDateBox" Width="130"
                                                 Margin="0,6,0,0" Padding="6"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Text="{loc:Text stats_followers}"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBox x:Name="StatsFollowersBox" Width="130"
                                                 Margin="0,6,0,0" Padding="6"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Text="{loc:Text stats_growth}"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBox x:Name="StatsGrowthBox" Width="130"
                                                 Margin="0,6,0,0" Padding="6"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,12">
                                        <TextBlock Text="{loc:Text stats_engagement}"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBox x:Name="StatsEngagementBox" Width="130"
                                                 Margin="0,6,0,0" Padding="6"/>
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Text="{loc:Text stats_notes}"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBox x:Name="StatsNotesBox" Margin="0,6,0,0" Padding="6" Height="34"/>

                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="SaveStatisticsButton"
                                            Content="{loc:Text stats_save}" Click="SaveStatistics_Click"
                                            Background="{DynamicResource AccentSuccess}"
                                            Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                            Padding="18,10" Margin="0,0,12,0"/>
                                    <Button Content="{loc:Text stats_refresh}" Click="RefreshStatistics_Click"
                                            Background="{DynamicResource AccentPrimary}"
                                            Foreground="{DynamicResource OnAccent}" BorderThickness="0"
                                            Padding="18,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="StatsMessageText" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSuccess}"/>

                        <DataGrid x:Name="StatisticsGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                  CanUserAddRows="False" MinHeight="240" Margin="0,16,0,0"/>

                        <!-- ===== Phase 3: real follower growth ===== -->
                        <TextBlock Text="{loc:Text growth_title}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,28,0,0"/>

                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="4" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text growth_latest}"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="GrowthLatestText" Text="â€”"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="4" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text growth_total}"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="GrowthTotalText" Text="â€”"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSuccess}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="4" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text growth_engagement}"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="GrowthEngagementText" Text="â€”"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1" CornerRadius="8" Margin="4" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text growth_records}"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="GrowthRecordsText" Text="â€”"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Text growth_chart_caption}"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                <loc:LineChart x:Name="GrowthChart" Height="230"
                                               Accent="{DynamicResource AccentSuccess}"
                                               GridBrush="{DynamicResource AppBorder}"
                                               LabelBrush="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{loc:Text growth_comparison}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,28,0,0"/>

                        <DataGrid x:Name="ComparisonGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                  CanUserAddRows="False" MinHeight="180" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource StatusBarBackground}" CornerRadius="5" Padding="9" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="{loc:Text status_ready}"/>
        </Border>
    </Grid>
</Window>




