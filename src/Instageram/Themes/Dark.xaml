<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= INSTAGERAM theme: Dark =================
         Same keys as Light.xaml; only the values differ, so switching
         themes at runtime updates every DynamicResource reference. -->

    <SolidColorBrush x:Key="AppBackground"       Color="#12171F"/>
    <SolidColorBrush x:Key="AppSurface"          Color="#1B2230"/>
    <SolidColorBrush x:Key="AppBorder"           Color="#2C3648"/>

    <SolidColorBrush x:Key="HeaderBackground"    Color="#0B0F16"/>
    <SolidColorBrush x:Key="HeaderForeground"    Color="#E6EDF5"/>
    <SolidColorBrush x:Key="HeaderSubtle"        Color="#8FB6D4"/>

    <SolidColorBrush x:Key="TextPrimary"         Color="#E6EDF5"/>
    <SolidColorBrush x:Key="TextMuted"           Color="#93A2B5"/>
    <SolidColorBrush x:Key="TextBody"            Color="#C3CEDA"/>
    <SolidColorBrush x:Key="TextSuccess"         Color="#4FD1A5"/>

    <SolidColorBrush x:Key="PanelBackground"     Color="#1E2735"/>
    <SolidColorBrush x:Key="PanelBorder"         Color="#2C3648"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#1A2130"/>

    <SolidColorBrush x:Key="AccentPrimary"       Color="#3D6EA8"/>
    <SolidColorBrush x:Key="AccentSuccess"       Color="#14876A"/>
    <SolidColorBrush x:Key="AccentDark"          Color="#22334D"/>
    <SolidColorBrush x:Key="AccentNeutral"       Color="#A66A2C"/>
    <SolidColorBrush x:Key="AccentWarning"       Color="#B66B19"/>
    <SolidColorBrush x:Key="OnAccent"            Color="#FFFFFF"/>

    <!-- ================= shared control defaults ================= -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="RowBackground" Value="{DynamicResource AppSurface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
    </Style>

</ResourceDictionary>
