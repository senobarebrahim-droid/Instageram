<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= INSTAGERAM theme: Light =================
         Every colour in MainWindow.xaml is a DynamicResource key, so the
         theme can be swapped while the application is running. -->

    <SolidColorBrush x:Key="AppBackground"       Color="#F3F6FA"/>
    <SolidColorBrush x:Key="AppSurface"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppBorder"           Color="#D8E0E8"/>

    <SolidColorBrush x:Key="HeaderBackground"    Color="#1B263B"/>
    <SolidColorBrush x:Key="HeaderForeground"    Color="#DCE6F2"/>
    <SolidColorBrush x:Key="HeaderSubtle"        Color="#A9D6E5"/>

    <SolidColorBrush x:Key="TextPrimary"         Color="#1B263B"/>
    <SolidColorBrush x:Key="TextMuted"           Color="#607080"/>
    <SolidColorBrush x:Key="TextBody"            Color="#405468"/>
    <SolidColorBrush x:Key="TextSuccess"         Color="#1C7058"/>

    <SolidColorBrush x:Key="PanelBackground"     Color="#EAF2FA"/>
    <SolidColorBrush x:Key="PanelBorder"         Color="#C6D6E8"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#E4EAF1"/>

    <SolidColorBrush x:Key="AccentPrimary"       Color="#547AA5"/>
    <SolidColorBrush x:Key="AccentSuccess"       Color="#169873"/>
    <SolidColorBrush x:Key="AccentDark"          Color="#263B59"/>
    <SolidColorBrush x:Key="AccentNeutral"       Color="#A66A2C"/>
    <SolidColorBrush x:Key="AccentWarning"       Color="#B66B19"/>
    <SolidColorBrush x:Key="OnAccent"            Color="#FFFFFF"/>

    <!-- ================= shared control defaults ================= -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="RowBackground" Value="{DynamicResource AppSurface}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
    </Style>

</ResourceDictionary>
